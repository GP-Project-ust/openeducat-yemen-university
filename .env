# إعدادات البيئة — عدّلها ثم ارفع من جديد (docker compose up -d)
# ملاحظة: إذا غيّرت DB_NAME بعد أول تشغيل فستبدأ قاعدة جديدة فارغة

# اسم قاعدة البيانات
DB_NAME=university

# مستخدم/كلمة مرور PostgreSQL (داخل الحاوية)
DB_USER=odoo
DB_PASSWORD=odoo

# منفذ أودو على جهازك
ODOO_PORT=8069

# كلمة مرور مستخدم admin في أودو (للمولّد والتوثيق — الافتراضي admin)
ADMIN_PASSWORD=admin
